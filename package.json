{
  "name": "solidity-ai-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Pinned MCP servers (Solhint lint) and build, test and lint rules for AI coding agents on Solidity (Foundry, Hardhat). For Codex, Cursor and Claude Code",
  "type": "module",
  "bin": {
    "solidity-ai-kit": "src/bin.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:packed": "node test/packed-smoke.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "readme": "node scripts/readme-components.js"
  },
  "keywords": [
    "solidity",
    "smart-contracts",
    "ethereum",
    "foundry",
    "hardhat",
    "solhint",
    "lint",
    "linter",
    "testing",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "ai-coding-agent",
    "codex",
    "cursor",
    "claude-code",
    "cli",
    "developer-tools"
  ],
  "author": "Vitaliy Chernov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vschernoff/solidity-ai-kit.git"
  },
  "homepage": "https://github.com/vschernoff/solidity-ai-kit#readme",
  "bugs": {
    "url": "https://github.com/vschernoff/solidity-ai-kit/issues"
  },
  "files": [
    "src/",
    "kit.manifest.json",
    "kit.manifest.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "spdx-expression-parse": "5.0.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  }
}
